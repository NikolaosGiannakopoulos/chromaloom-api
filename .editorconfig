root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,csproj.user,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

# Prefer file-scoped namespaces (EnforceCodeStyleInBuild).
csharp_style_namespace_declarations = file_scoped:warning

# As an error, forces GenerateDocumentationFile on every project.
dotnet_diagnostic.IDE0005.severity = suggestion

# var is preferred.
dotnet_diagnostic.IDE0008.severity = none

# Fluent APIs always return a value.
dotnet_diagnostic.IDE0058.severity = none

# DI constructs internal types.
dotnet_diagnostic.CA1812.severity = none

# Modular monolith libraries intentionally expose public APIs to sibling projects.
dotnet_diagnostic.CA1515.severity = none

# ASP.NET Core / libraries — no sync context; ConfigureAwait is noise.
dotnet_diagnostic.CA2007.severity = none

# Domain exceptions always carry a Code — standard empty/message constructors don't fit.
dotnet_diagnostic.CA1032.severity = none

# Result<T>.Success/Failure — normal for the Result pattern.
dotnet_diagnostic.CA1000.severity = none

# Implicit operators pair with Success/Failure.
dotnet_diagnostic.CA2225.severity = none

# Type name Error is Result-pattern vocabulary.
dotnet_diagnostic.CA1716.severity = none
