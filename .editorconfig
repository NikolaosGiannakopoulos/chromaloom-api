root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,csproj.user,props,targets,slnx,xml,json,yml,yaml}]
indent_size = 2

[*.cs]
indent_size = 4

dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1515.severity = none
